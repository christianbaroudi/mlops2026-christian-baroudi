# Copy this file to .env (from the Experiment Tracking lab). Compose reads .env: it
# passes these values to Postgres, which creates the user and the database on its first
# start, and puts them in the connection strings of MLflow and of our jobs.
# .env is in .gitignore, so that passwords never reach Git. This template has
# no real secret, so it is committed.
POSTGRES_USER=mlflow_user
POSTGRES_PASSWORD=mlflow_password
POSTGRES_DB=mlflow_db
